import reflection1br from "../assets/housing-photos/Reflections 1 Bedroom-1 Bathroom.png";
import reflection2br from "../assets/housing-photos/Reflections 2 Bedroom-2 Bathroom.png";
import mix1br from "../assets/housing-photos/The Mix 1 Bedroom 1 Bathroom.jpg";
import mix2br from "../assets/housing-photos/The Mix 2 Bedroom 2 Bathroom.jpeg";
import yugo1br from "../assets/housing-photos/Yugo Atlanta Summerhill 1 Bedroom 1 Bathroom.jpg";
import yugo2br from "../assets/housing-photos/Yugo Atlanta Summerhill 2 Bedroom 2 Bathroom.jpg";

// Keyed by `${name}-${bedrooms}` since one complex can have multiple
// unit sizes with different photos (Reflection 1BR looks nothing
// like Reflection 2BR). Falls back to <PhotoPlaceholder /> if a
// listing's name+bedroom combo isn't in here.
const listingPhotos = {
  "Reflection-1": reflection1br,
  "Reflection-2": reflection2br,
  "The Mix-1": mix1br,
  "The Mix-2": mix2br,
  "Yugo Atlanta Summerhill-1": yugo1br,
  "Yugo Atlanta Summerhill-2": yugo2br,
};

export function getListingPhoto(listing) {
  return listingPhotos[`${listing.name}-${listing.bedrooms}`];
}
